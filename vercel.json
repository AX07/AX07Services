{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/demo/:path*", "destination": "/" },
    { "source": "/admin", "destination": "/" },
    { "source": "/(ie|pt)", "destination": "/" },
    { "source": "/(ie|pt)/(work|about)", "destination": "/$2" },
    { "source": "/(ie|pt)/(demo/.*|admin)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(logo-points.bin|showcase/.*|work/.*\\.webp|about/.*\\.webp|og-image.jpg|logo-mark.png|favicon.ico)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
